# Copy to .env.local and fill in. Never commit real values.
# Every key here is also declared (and validated) in src/env.ts.

# --- Site ---------------------------------------------------------------
# Public base URL. On Vercel it falls back to the production domain automatically.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# --- Database: Neon Postgres (Stage 2) ----------------------------------
# Added automatically by the Vercel ↔ Neon integration.
DATABASE_URL=
DATABASE_URL_UNPOOLED=

# --- AI: Vercel AI Gateway (Stage 4) ------------------------------------
AI_GATEWAY_API_KEY=

# --- Storage: Vercel Blob (Stage 5) -------------------------------------
BLOB_READ_WRITE_TOKEN=

# --- Cron (Stage 5 / 13) ------------------------------------------------
# Any random string, at least 16 characters long.
CRON_SECRET=

# --- Auth: Better Auth + Sign in with Vercel (Stage 9) ------------------
# Generate with: openssl rand -base64 32
BETTER_AUTH_SECRET=
BETTER_AUTH_URL=http://localhost:3000
VERCEL_APP_CLIENT_ID=
VERCEL_APP_CLIENT_SECRET=
